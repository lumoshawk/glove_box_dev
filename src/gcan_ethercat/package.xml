<?xml version="1.0"?>
<package format="3">
  <name>gcan_ethercat</name>
  <version>0.1.0</version>
  <description>GCAN-8221 EtherCAT to CAN / CANopen master gateway: CAN frames over EtherCAT process data, a CANopen (NMT / SDO / CiA402) client on top, and read / enable tests for CANopen drives (EYOU PHU) behind it</description>
  <maintainer email="lumos@todo.todo">lumos</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>gpio_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ethercat_driver</exec_depend>
  <exec_depend>ethercat_generic_plugins</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
